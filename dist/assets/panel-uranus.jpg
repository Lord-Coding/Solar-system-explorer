<script id="soco-blv-swiper">
(function(){
	function attachSliderEvents(root){
		root.querySelectorAll('.slider-blv').forEach(function(t){
			if ( t.dataset.socoSlider ) return;
			t.dataset.socoSlider = '1';
			var box  = t.closest('.match-blv-box');
			if ( ! box ) return;
			var e    = box.querySelector('.prev-btn');
			var n    = box.querySelector('.next-btn');
			if ( ! t || ! e || ! n ) return;
			var s = false, a = 0, i = 0, r = 0, o = 0, l = false;
			function c(){
				e.disabled = t.scrollLeft <= 0;
				n.disabled = Math.ceil(t.scrollLeft + t.offsetWidth) >= t.scrollWidth - 1;
				if ( e.disabled && n.disabled ) {
					box.classList.add('both-disabled');
					t.style.justifyContent = 'center';
				} else {
					box.classList.remove('both-disabled');
				}
			}
			function u(dir){
				if ( l ) return;
				l = true;
				var nx = ( dir === 'left' ) ? t.scrollLeft - 200 : t.scrollLeft + 200;
				t.scrollTo({ left: nx, behavior: 'smooth' });
				setTimeout(function(){ l = false; c(); }, 500);
			}
			t.addEventListener('touchstart', function(ev){
				s = true;
				var tch = ev.touches[0];
				a = tch.pageX - t.offsetLeft;
				i = t.scrollLeft;
				o = Date.now();
				r = 0;
			});
			t.addEventListener('touchmove', function(ev){
				if ( ! s ) return;
				ev.preventDefault();
				var px = ev.touches[0].pageX - t.offsetLeft;
				r = Math.abs(px - a);
				t.scrollLeft = i - (px - a);
			});
			t.addEventListener('touchend', function(ev){
				if ( ! s ) return;
				var dt = Date.now() - o;
				if ( ev.changedTouches && ev.changedTouches[0] ) {
					if ( dt >= 200 || r >= 5 ) { ev.preventDefault(); ev.stopPropagation(); }
				}
				s = false; c();
			});
			t.addEventListener('click', function(ev){
				if ( r > 5 ) { ev.preventDefault(); ev.stopPropagation(); }
			}, true);
			t.addEventListener('scroll', c);
			e.addEventListener('click', function(){ u('left');  });
			n.addEventListener('click', function(){ u('right'); });
			c();
		});
	}
	function init(){ attachSliderEvents(document.body); }
	if ( document.readyState === 'loading' ) {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
})();
</script>
<style id="soco-blv-swiper-css">
.match-blv-box[swiper-container],.match-blv-box[swiper-container=""]{display:flex;align-items:center;gap:4px;}
.match-blv-box .slider-wrapper{flex:1;min-width:0;overflow:hidden;}
.match-blv-box .slider-blv{display:flex;gap:4px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;}
.match-blv-box .slider-blv::-webkit-scrollbar{display:none;}
.match-blv-box .nav-btn{flex:none;background:transparent;border:0;padding:6px 4px;cursor:pointer;opacity:.85;}
.match-blv-box .nav-btn[disabled]{opacity:.25;cursor:default;}
.match-blv-box .nav-btn:hover:not([disabled]){opacity:1;}
</style>
