		<style id="soco-engine-color-tokens">:root{--scl-primary:#00FFFD;--scl-background:#0a0a0a;--scl-card-bg:#161616;--scl-card-border:#222222;--scl-text:#ffffff;--scl-text-secondary:#bdbdbd;--scl-link:#00FFFD;--scl-link-hover:#2d7542;--scl-button-bg:#00FFFD;--scl-button-text:#000000;--scl-button-hover:#00cdcb;--scl-hot:#dd3333;--scl-badge-live:#22c55e;--scl-badge-live-text:#ffffff;--scl-badge-finished:#6b7280;--scl-badge-upcoming:#3b82f6;--scl-score:#ffffff;--scl-tib-win:#00FFFD;--scl-sport-tab-bg:#1a1a1a;--scl-sport-tab-active:#00FFFD;--scl-filter-bg:#212121;--scl-filter-active:#00FFFD;}
.soco-frontend-root,.match-list-shortcode,.soco-archive{color:var(--scl-text);}
.soco-frontend-root .match-item,.match-list-shortcode .match-item{background:var(--scl-card-bg)!important;border-color:var(--scl-card-border)!important;}
.soco-frontend-root .match-item.live-match .status-text,.match-list-shortcode .live-match .status-text{color:var(--scl-badge-live-text,#ffffff)!important;}
.soco-frontend-root .match-item.finished,.match-list-shortcode .match-item.finished{color:var(--scl-badge-finished)!important;}
.soco-frontend-root .match-score-scl.score-match-data,.match-list-shortcode .match-score-scl.score-match-data{color:var(--scl-score)!important;}
.soco-frontend-root .tib-win,.match-list-shortcode .tib-win{color:var(--scl-tib-win)!important;font-weight:700;}
.soco-frontend-root .sports-bars .nav-link.active,.match-list-shortcode .sports-bars .nav-link.active{color:var(--scl-sport-tab-active)!important;}
.soco-frontend-root .sports-bars .nav-link,.match-list-shortcode .sports-bars .nav-link{background:var(--scl-sport-tab-bg);}
.soco-frontend-root .match_filter_wg li,.match-list-shortcode .match_filter_wg li{background:var(--scl-filter-bg);}
.soco-frontend-root .match_filter_wg li.active,.match-list-shortcode .match_filter_wg li.active{background:var(--scl-filter-active)!important;color:var(--scl-button-text)!important;}
.soco-frontend-root .btn,.match-list-shortcode .btn,.soco-frontend-root .load-more-wg,.match-list-shortcode .load-more-wg{background:var(--scl-button-bg)!important;color:var(--scl-button-text)!important;}
.soco-frontend-root .btn:hover,.match-list-shortcode .btn:hover{background:var(--scl-button-hover)!important;}
.soco-frontend-root a,.match-list-shortcode a{color:var(--scl-link);}
.soco-frontend-root a:hover,.match-list-shortcode a:hover{color:var(--scl-link-hover);}
a.soco-gototop{position:fixed;right:18px;bottom:18px;width:42px;height:42px;border-radius:50%;display:none;align-items:center;justify-content:center;text-decoration:none;font-size:20px;line-height:1;z-index:50;color:#ffffff;background:transparent;border:2px solid #00FFFD;transition:background .2s,color .2s,transform .2s;}a.soco-gototop.is-visible{display:flex;}a.soco-gototop:hover{color:#ffffff;background:#00FFFD;transform:translateY(-2px);}</style>
