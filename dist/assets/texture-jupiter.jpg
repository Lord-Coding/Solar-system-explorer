ription":-1,"theme":-1,"image":420},"wagtailcore_page_kxj6jl8","118711",15.887048,{"pk":359,"title":362,"title_edgengrams":362,"title_filter":362,"id_filter":363,"live_filter":364,"owner_id_filter":42,"content_type_id_filter":365,"path_filter":366,"depth_filter":367,"locked_filter":7,"show_in_menus_filter":7,"first_published_at_filter":368,"last_published_at_filter":368,"latest_revision_created_at_filter":368,"locale_id_filter":369,"translation_key_filter":370,"image_detail_imagedetailpage__image":371,"url":373,"image_detail_imagedetailpage__pia_number":374,"image_detail_imagedetailpage__body":375,"image_detail_imagedetailpage__related_mission":377,"image_detail_imagedetailpage__targets":379,"image_detail_imagedetailpage__spacecraft":382,"image_detail_imagedetailpage__instruments":385,"image_detail_imagedetailpage__get_topic_titles_filter":103,"image_detail_imagedetailpage__label":388,"topic_labels_filter":389,"publication_date_filter":390,"image_detail_imagedetailpage__display_in_gallery_filter":364,"image_detail_imagedetailpage__featured_filter":7,"image_detail_imagedetailpage__notify_filter":7,"image_detail_imagedetailpage__notification_message":42,"_edgengrams":391,"content_type":392},"Cassini's Best Maps of Jupiter (Cylindrical Map)",118711,true,18,"0001000100010AD1",4,"2006-03-27T21:50:01+00:00",1,"be4249bf-9896-4b83-b7e7-c113a5d209e1",{"thumbnail_image":372},"https://d2pn8kiwq2w21t.cloudfront.net/images/jpegPIA07782.2e16d0ba.fill-400x400-c50.jpg","https://www.jpl.nasa.gov/images/pia07782-cassinis-best-maps-of-jupiter-cylindrical-map","PIA07782",[376],"Cylindrical Map without GridCylindrical Map with Grid This map is part of a group release of cylindrical and polar stereographic projections of Jupiter. For the other maps see PIA07783 and PIA07784. These color maps of Jupiter were constructed from images taken by the narrow-angle camera onboard NASA's Cassini spacecraft on Dec. 11 and 12, 2000, as the spacecraft neared Jupiter during its flyby of the giant planet. Cassini was on its way to Saturn. They are the most detailed global color maps of Jupiter ever produced. The smallest visible features are about 120 kilometers (75 miles) across. The maps are composed of 36 images: a pair of images covering Jupiter's northern and southern hemispheres was acquired in two colors every hour for nine hours as Jupiter rotated beneath the spacecraft. Although the raw images are in just two colors, 750 nanometers (near-infrared) and 451 nanometers (blue), the map's colors are close to those the human eye would see when gazing at Jupiter. The maps show a variety of colorful cloud features, including parallel reddish-brown and white bands, the Great Red Spot, multi-lobed chaotic regions, white ovals and many small vortices. Many clouds appear in streaks and waves due to continual stretching and folding by Jupiter's winds and turbulence. The bluish-gray features along the north edge of the central bright band are equatorial \"hot spots,\" meteorological systems such as the one entered by NASA's Galileo probe. Small bright spots within the orange band north of the equator are lightning-bearing thunderstorms. The polar regions are less clearly visible because Cassini viewed them at an angle and through thicker atmospheric haze (such as the whitish material in the south polar map -- see PIA07784. Pixels in the rectangular map cover equal increments of planetocentric latitude (which is measured relative to the center of the planet) and longitude, and extend to 180 degrees of latitude and 360 degrees of longitude. The Cassini-Huygens mission is a cooperative project of NASA, the European Space Agency and the Italian Space Agency. The Jet Propulsion Laboratory, a division of the California Institute of Technology in Pasadena, manages the mission for NASA's Science Mission Directorate, Washington, D.C. The Cassini orbiter and its two onboard cameras were designed, developed and assembled at JPL. The imaging operations center is based at the Space Science Institute in Boulder, Colo. For more information about the Cassini-Huygens mission visit http://saturn.jpl.nasa.gov/home/index.cfm. The Cassini imaging team homepage is at http://ciclops.org.",[378],"Mission to Saturn",[380],{"target_id":381},19,[383],{"spacecraft_id":384},12,[386],{"instrument_id":387},288,"Image",[103],"2006-03-27",[362],[393,394],"image_detail.ImageDetailPage","wagtailcore.Page",{"pk":396},[359],[360,398],"2006-03-27 00:00:00",{"latest":400},{"hits":401},{"total":402,"max_score":360,"hits":403},{"value":369,"relation":355},[404],{"_index":358,"_id":359,"_score":360,"_source":405},{"pk":359,"title":362,"title_edgengrams":362,"title_filter":362,"id_filter":363,"live_filter":364,"owner_id_filter":42,"content_type_id_filter":365,"path_filter":366,"depth_filter":367,"locked_filter":7,"show_in_menus_filter":7,"first_published_at_filter":368,"last_published_at_filter":368,"latest_revision_created_at_filter":368,"locale_id_filter":369,"translation_key_filter":370,"image_detail_imagedetailpage__image":406,"url":373,"image_detail_imagedetailpage__pia_number":374,"image_detail_imagedetailpage__body":407,"image_detail_imagedetailpage__related_mission":408,"image_detail_imagedetailpage__targets":409,"image_detail_imagedetailpage__spacecraft":411,"image_detail_imagedetailpage__instruments":413,"image_detail_imagedetailpage__get_topic_titles_filter":103,"image_detail_imagedetailpage__label":388,"topic_labels_filter":415,"publication_date_filter":390,"image_detail_imagedetailpage__display_in_gallery_filter":364,"image_detail_imagedetailpage__featured_filter":7,"image_detail_imagedetailpage__notify_filter":7,"image_detail_imagedetailpage__notification_message":42,"_edgengrams":416,"content_type":417},{"thumbnail_image":372},[376],[378],[410],{"target_id":381},[412],{"spacecraft_id":384},[414],{"instrument_id":387},[103],[362],[393,394],"image_detail_imagedetailpage","March 27, 2006",{"src":421},{"url":372},{"_index":358,"_id":423,"_score":424,"_source":425,"fields":447,"sort":449,"inner_hits":450,"content_type":418,"id":423,"score":424,"url":433,"title":426,"type":388,"topic":103,"location":-1,"startDate":42,"endDate":42,"startTime":42,"endTime":42,"startDatetime":42,"endDatetime":42,"eventType":-1,"customDate":-1,"ongoing":-1,"targetAudience":-1,"gradeLevels":-1,"time":-1,"primarySubject":-1,"summary":-1,"date":419,"wait":-1,"locationIcon":-1,"searchDescription":-1,"theme":-1,"image":469},"118706",6.292371,{"pk":423,"title":426,"title_edgengrams":426,"title_filter":426,"id_filter":427,"live_filter":364,"owner_id_filter":42,"content_type_id_filter":365,"path_filter":428,"depth_filter":367,"locked_filter":7,"show_in_menus_filter":7,"first_published_at_filter":429,"last_published_at_filter":429,"latest_revision_created_at_filter":429,"locale_id_filter":369,"translation_key_filter":430,"image_detail_imagedetailpage__image":431,"url":433,"image_detail_imagedetailpage__pia_number":434,"image_detail_imagedetailpage__body":435,"image_detail_imagedetailpage__related_mission":437,"image_detail_imagedetailpage__targets":438,"image_detail_imagedetailpage__spacecraft":440,"image_detail_imagedetailpage__instruments":442,"image_detail_imagedetailpage__get_topic_titles_filter":103,"image_detail_imagedetailpage__label":388,"topic_labels_filter":444,"publication_date_filter":390,"image_detail_imagedetailpage__display_in_gallery_filter":364,"image_detail_imagedetailpage__featured_filter":7,"image_detail_imagedetailpage__notify_filter":7,"image_detail_imagedetailpage__notification_message":42,"_edgengrams":445,"content_type":446},"Cassini's Best Maps of Jupiter (South Polar Map)",118706,"0001000100010ACW","2006-03-27T21:50:03+00:00","ae95a3e4-a913-49dc-8c25-865407094bfa",{"thumbnail_image":432},"https://d2pn8kiwq2w21t.cloudfront.net/images/jpegPIA07784.2e16d0ba.fill-400x400-c50.jpg","https://www.jpl.nasa.gov/images/pia07784-cassinis-best-maps-of-jupiter-south-polar-map","PIA07784",[436],"South Polar without GridSouth Polar with Grid These color maps of Jupiter were constructed from images taken by the narrow-angle camera onboard NASA's Cassini spacecraft on Dec. 11 and 12, 2000, as the spacecraft neared Jupiter during its flyby of the giant planet. Cassini was on its way to Saturn. They are the most detailed global color maps of Jupiter ever produced; the smallest visible features are about 120 kilometers (75 miles) across. For other maps see PIA07782 and PIA07783. The maps are composed of 36 images: a pair of images covering Jupiter's northern and southern hemispheres was acquired in two colors every hour for nine hours as Jupiter rotated beneath the spacecraft. Although the raw images are in just two colors, 750 nanometers (near-infrared) and 451 nanometers (blue), the map's colors are close to those the human eye would see when gazing at Jupiter. The maps show a variety of colorful cloud features, including parallel reddish-brown and white bands, the Great Red Spot, multi-lobed chaotic regions, white ovals and many small vortices. Many clouds appear in streaks and waves due to continual stretching and folding by Jupiter's winds and turbulence. The bluish-gray features along the north edge of the central bright band are equatorial \"hot spots,\" meteorological systems such as the one entered by NASA's Galileo probe. Small bright spots within the orange band north of the equator are lightning-bearing thunderstorms. The polar regions shown here are less clearly visible because Cassini viewed them at an angle and through thicker atmospheric haze. The round maps are polar stereographic projections that show the north or south pole in the center of the map and the equator at the edge. The Cassini-Huygens mission is a cooperative project of NASA, the European Space Agency and the Italian Space Agency. The Jet Propulsion Laboratory, a division of the California Institute of Technology in Pasadena, manages the mission for NASA's Science Mission Directorate, Washington, D.C. The Cassini orbiter and its two onboard cameras were designed, developed and assembled at JPL. The imaging operations center is based at the Space Science Institute in Boulder, Colo. For more information about the Cassini-Huygens mission visit http://saturn.jpl.nasa.gov/home/index.cfm. The Cassini imaging team homepage is at http://ciclops.org.",[378],[439],{"target_id":381},[441],{"spacecraft_id":384},[443],{"instrument_id":387},[103],[426],[393,394],{"pk":448},[423],[424,398],{"latest":451},{"hits":452},{"total":453,"max_score":424,"hits":454},{"value":369,"relation":355},[455],{"_index":358,"_id":423,"_score":424,"_source":456},{"pk":423,"title":426,"title_edgengrams":426,"title_filter":426,"id_filter":427,"live_filter":364,"owner_id_filter":42,"content_type_id_filter":365,"path_filter":428,"depth_filter":367,"locked_filter":7,"show_in_menus_filter":7,"first_published_at_filter":429,"last_published_at_filter":429,"latest_revision_created_at_filter":429,"locale_id_filter":369,"translation_key_filter":430,"image_detail_imagedetailpage__image":457,"url":433,"image_detail_imagedetailpage__pia_number":434,"image_detail_imagedetailpage__body":458,"image_detail_imagedetailpage__related_mission":459,"image_detail_imagedetailpage__targets":460,"image_detail_imagedetailpage__spacecraft":462,"image_detail_imagedetailpage__instruments":464,"image_detail_imagedetailpage__get_topic_titles_filter":103,"image_detail_imagedetailpage__label":388,"topic_labels_filter":466,"publication_date_filter":390,"image_detail_imagedetailpage__display_in_gallery_filter":364,"image_detail_imagedetailpage__featured_filter":7,"image_detail_imagedetailpage__notify_filter":7,"image_detail_imagedetailpage__notification_message":42,"_edgengrams":467,"content_type":468},{"thumbnail_image":432},[436],[378],[461],{"target_id":381},[463],{"spacecraft_id":384},[465],{"instrument_id":387},[103],[426],[393,394],{"src":470},{"url":432},{"_index":358,"_id":472,"_score":473,"_source":474,"fields":496,"sort":498,"inner_hits":499,"content_type":418,"id":472,"score":473,"url":482,"title":475,"type":388,"topic":103,"location":-1,"startDate":42,"endDate":42,"startTime":42,"endTime":42,"startDatetime":42,"endDatetime":42,"eventType":-1,"customDate":-1,"ongoing":-1,"targetAudience":-1,"gradeLevels":-1,"time":-1,"primarySubject":-1,"summary":-1,"date":419,"wait":-1,"locationIcon":-1,"searchDescription":-1,"theme":-1,"image":518},"118710",6.0414524,{"pk":472,"title":475,"title_edgengrams":475,"title_filter":475,"id_filter":476,"live_filter":364,"owner_id_filter":42,"content_type_id_filter":365,"path_filter":477,"depth_filter":367,"locked_filter":7,"show_in_menus_filter":7,"first_published_at_filter":478,"last_published_at_filter":478,"latest_revision_created_at_filter":478,"locale_id_filter":369,"translation_key_filter":479,"image_detail_imagedetailpage__image":480,"url":482,"image_detail_imagedetailpage__pia_number":483,"image_detail_imagedetailpage__body":484,"image_detail_imagedetailpage__related_mission":486,"image_detail_imagedetailpage__targets":487,"image_detail_imagedetailpage__spacecraft":489,"image_detail_imagedetailpage__instruments":491,"image_detail_imagedetailpage__get_topic_titles_filter":103,"image_detail_imagedetailpage__label":388,"topic_labels_filter":493,"publication_date_filter":390,"image_detail_imagedetailpage__display_in_gallery_filter":364,"image_detail_imagedetailpage__featured_filter":7,"image_detail_imagedetailpage__notify_filter":7,"image_detail_imagedetailpage__notification_message":42,"_edgengrams":494,"content_type":495},"Cassini's Best Maps of Jupiter (North Polar Map)",118710,"0001000100010AD0","2006-03-27T21:50:02+00:00","b0d86f02-106c-454f-a307-ed81833c8b52",{"thumbnail_image":481},"https://d2pn8kiwq2w21t.cloudfront.net/images/jpegPIA07783.2e16d0ba.fill-400x400-c50.jpg","https://www.jpl.nasa.gov/images/pia07783-cassinis-best-maps-of-jupiter-north-polar-map","PIA07783",[485],"North Polar without GridNorth Polar with Grid This map is part of a group release of cylindrical and polar stereographic projections of Jupiter. For the other maps see PIA07782 and PIA07784. These color maps of Jupiter were constructed from images taken by the narrow-angle camera onboard NASA's Cassini spacecraft on Dec. 11 and 12, 2000, as the spacecraft neared Jupiter during its flyby of the giant planet. Cassini was on its way to Saturn. They are the most detailed global color maps of Jupiter ever produced. The smallest visible features are about 120 kilometers (75 miles) across. The maps are composed of 36 images: a pair of images covering Jupiter's northern and southern hemispheres was acquired in two colors every hour for nine hours as Jupiter rotated beneath the spacecraft. Although the raw images are in just two colors, 750 nanometers (near-infrared) and 451 nanometers (blue), the map's colors are close to those the human eye would see when gazing at Jupiter. The maps show a variety of colorful cloud features, including parallel reddish-brown and white bands, the Great Red Spot, multi-lobed chaotic regions, white ovals and many small vortices. Many clouds appear in streaks and waves due to continual stretching and folding by Jupiter's winds and turbulence. The bluish-gray features along the north edge of the central bright band are equatorial \"hot spots,\" meteorological systems such as the one entered by NASA's Galileo probe. Small bright spots within the orange band north of the equator are lightning-bearing thunderstorms. The polar regions are less clearly visible because Cassini viewed them at an angle and through thicker atmospheric haze (such as the whitish material in the south polar map -- see PIA07784. Pixels in the rectangular map cover equal increments of planetocentric latitude (which is measured relative to the center of the planet) and longitude, and extend to 180 degrees of latitude and 360 degrees of longitude. The Cassini-Huygens mission is a cooperative project of NASA, the European Space Agency and the Italian Space Agency. The Jet Propulsion Laboratory, a division of the California Institute of Technology in Pasadena, manages the mission for NASA's Science Mission Directorate, Washington, D.C. The Cassini orbiter and its two onboard cameras were designed, developed and assembled at JPL. The imaging operations center is based at the Space Science Institute in Boulder, Colo. For more information about the Cassini-Huygens mission visit http://saturn.jpl.nasa.gov/home/index.cfm. The Cassini imaging team homepage is at http://ciclops.org.",[378],[488],{"target_id":381},[490],{"spacecraft_id":384},[492],{"instrument_id":387},[103],[475],[393,394],{"pk":497},[472],[473,398],{"latest":500},{"hits":501},{"total":502,"max_score":473,"hits":503},{"value":369,"relation":355},[504],{"_index":358,"_id":472,"_score":473,"_source":505},{"pk":472,"title":475,"title_edgengrams":475,"title_filter":475,"id_filter":476,"live_filter":364,"owner_id_filter":42,"content_type_id_filter":365,"path_filter":477,"depth_filter":367,"locked_filter":7,"show_in_menus_filter":7,"first_published_at_filter":478,"last_published_at_filter":478,"latest_revision_created_at_filter":478,"locale_id_filter":369,"translation_key_filter":479,"image_detail_imagedetailpage__image":506,"url":482,"image_detail_imagedetailpage__pia_number":483,"image_detail_imagedetailpage__body":507,"image_detail_imagedetailpage__related_mission":508,"image_detail_imagedetailpage__targets":509,"image_detail_imagedetailpage__spacecraft":511,"image_detail_imagedetailpage__instruments":513,"image_detail_imagedetailpage__get_topic_titles_filter":103,"image_detail_imagedetailpage__label":388,"topic_labels_filter":515,"publication_date_filter":390,"image_detail_imagedetailpage__display_in_gallery_filter":364,"image_detail_imagedetailpage__featured_filter":7,"image_detail_imagedetailpage__notify_filter":7,"image_detail_imagedetailpage__notification_message":42,"_edgengrams":516,"content_type":517},{"thumbnail_image":481},[485],[378],[510],{"target_id":381},[512],{"