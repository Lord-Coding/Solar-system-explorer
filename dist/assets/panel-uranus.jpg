(function(){
  var REST = "https:\/\/xoilac86xzts.io\/wp-json\/soco\/v1";
  function map(u){
    if (typeof u !== 'string') return u;
    if (!/(?:sportdb(c)?\.(?:live|com)|(?:[a-z0-9-]+\.)?sportbo\.live)/i.test(u)) return u;
    try {
      var url = new URL(u, location.href);
      var p = url.pathname, q = url.searchParams, m;
      var basketball = /^basketball\.sportbo\.live$/i.test(url.hostname) || /\/api\/v\d+\/basketball\//i.test(p);
      var sportQuery = basketball ? '?sport=basketball' : '';
      // /api/v1/matchs/season-result?match_id=X → /match/X/h2h
      // /api/v1/matchs/season-result?comp_id=X  → /h2h-by-comp (gate check
      // for standings page — sportdb often returns empty results which
      // would silently kill the table-standing chain).
      if (p.match(/\/api\/v\d+\/matchs\/season-result/)) {
        var id = q.get('match_id'); if (id) return REST + '/match/' + id + '/h2h';
        var cid = q.get('comp_id'); if (cid) return REST + '/h2h-by-comp?id=' + encodeURIComponent(cid);
      }
      // /api/v1/matchs/live/detail/X → /match/X/detail
      if ((m = p.match(/\/api\/v\d+\/(?:basketball\/)?matchs\/live\/detail\/([a-z0-9]+)/i))) return REST + '/match/' + m[1] + '/detail' + sportQuery;
      // /api/v1/matchs/lineup/X → /match/X/lineup
      if ((m = p.match(/\/api\/v\d+\/(?:basketball\/)?matchs\/lineup\/([a-z0-9]+)/i))) return REST + '/match/' + m[1] + '/lineup' + sportQuery;
      // /api/v1/matches/live/result/X → /match/X/result
      if ((m = p.match(/\/api\/v\d+\/matches\/live\/result\/([a-z0-9]+)/i))) return REST + '/match/' + m[1] + '/result' + sportQuery;
      // Dedicated Basketball detail contract.
      if ((m = p.match(/\/api\/v\d+\/matches\/recent\/([a-z0-9]+)/i))) return REST + '/match/' + m[1] + '/detail?sport=basketball';
      // /api/v1/matchs/stats?match_id=X → /match/X/stats
      if (p.match(/\/api\/v\d+\/(?:basketball\/)?matchs\/stats(\?|$)/) && !p.match(/stats-detail/)) {
        var id = q.get('match_id'); if (id) return REST + '/match/' + id + '/stats' + sportQuery;
      }
      // /api/v1/matchs/stats-detail?match_id=X → /match/X/stats-detail
      if (p.match(/\/api\/v\d+\/(?:basketball\/)?matchs\/stats-detail/)) {
        var id = q.get('match_id'); if (id) return REST + '/match/' + id + '/stats-detail' + sportQuery;
      }
      // /api/v1/odds/live?match_id=X&company_id=Y → /match/X/odds?company_id=Y
      // 1.6.30+ — forward company_id. Without it, upstream returns
      // the aggregate of all bookmakers (or first one only on some
      // sports), so the bundle's per-bookmaker row builder finds
      // empty arrays and body_odds renders blank.
      if (p.match(/\/api\/v\d+\/odds\/live/)) {
        if ((m = p.match(/\/api\/v\d+\/odds\/live\/([a-z0-9]+)/i))) return REST + '/match/' + m[1] + '/odds?sport=basketball';
        var id = q.get('match_id');
        if (id) {
          var cid = q.get('company_id');
          var oq = []; if (cid) oq.push('company_id=' + encodeURIComponent(cid)); if (basketball) oq.push('sport=basketball');
          return REST + '/match/' + id + '/odds' + (oq.length ? '?' + oq.join('&') : '');
        }
      }
      // /api/v1/seasons/table-standing → /standings
      if (p.match(/\/api\/v\d+\/seasons\/table-standing/)) {
        var args = []; ['match_id','comp_id','sport'].forEach(function(k){ var v=q.get(k); if(v) args.push(k+'='+encodeURIComponent(v)); });
        return REST + '/standings' + (args.length ? '?'+args.join('&') : '');
      }
      // /api/v1/players/stats?season_id=X → /topscorer?id=X
      if (p.match(/\/api\/v\d+\/players\/stats/)) {
        var id = q.get('season_id'); if (id) return REST + '/topscorer?id=' + encodeURIComponent(id);
      }
      // /api/v1/matches/schedules → /schedule
      if (p.match(/\/api\/v\d+\/matches\/schedules/)) {
        var args = []; ['date','sport'].forEach(function(k){ var v=q.get(k); if(v) args.push(k+'='+encodeURIComponent(v)); });
        return REST + '/schedule' + (args.length ? '?'+args.join('&') : '');
      }
      // /api/v1/matchs/realtime → /realtime (live score deltas)
      if (p.match(/\/api\/v\d+\/(?:basketball\/)?matchs\/realtime/)) return REST + '/realtime' + sportQuery;
      if (p.match(/\/api\/v\d+\/matches\/live-stream/)) return REST + '/realtime?sport=basketball';
      // /api/v1/matches/count-live → /live-count
      if (p.match(/\/api\/v\d+\/matches\/count-live/)) return REST + '/live-count';
      // Blanket fallthrough: any other /api/v1/* sportdb URL goes via
      // /passthrough — preserves all query params, server adds CORS
      // header + subdomain failover. Bundle still does its own decrypt.
      if (p.match(/^\/api\/v\d+\//)) {
        var pq = new URLSearchParams(q);
        pq.set('path', p);
        return REST + '/passthrough?' + pq.toString();
      }
      return u;
    } catch (e) { return u; }
  }
  function liveURL(u){
    if (typeof u !== 'string') return u;
    if (u.indexOf(REST + '/realtime') !== 0 && u.indexOf(REST + '/live-count') !== 0 && u.indexOf(REST + '/broadcasts') !== 0) return u;
    var sep = u.indexOf('?') === -1 ? '?' : '&';
    return u + sep + '_soco_live=' + Math.floor(Date.now()/10000);
  }
  if (typeof window.fetch === 'function') {
    var _f = window.fetch;
    window.fetch = function(input, init){
      try {
        if (typeof input === 'string') input = liveURL(map(input));
        else if (input && input.url) { var nu = liveURL(map(input.url)); if (nu !== input.url) input = new Request(nu, input); }
      } catch (e) {}
      return _f.call(this, input, init);
    };
  }
  if (typeof XMLHttpRequest !== 'undefined' && XMLHttpRequest.prototype.open) {
    var _o = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function(m, u){
      try { u = liveURL(map(u)); } catch (e) {}
      arguments[1] = u;
      return _o.apply(this, arguments);
    };
  }
})();
