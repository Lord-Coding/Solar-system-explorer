  <script>
    const container = document.querySelector(".match-horizontals");
    const items = document.querySelectorAll(".match-horizontals-item");
    const nextHoriMatchBtn = document.getElementById("nextHoriMatchBtn");
    const prevHoriMatchBtn = document.getElementById("prevHoriMatchBtn");

    let currentIndex = 0;
    const step = 10;

    function updateButtonStatus() {
      prevHoriMatchBtn.disabled = currentIndex <= 0;
      nextHoriMatchBtn.disabled = currentIndex + step >= items.length;
    }

    nextHoriMatchBtn.addEventListener("click", () => {
      if (currentIndex + step < items.length) {
        currentIndex += step;
        scrollToCurrentItem();
        updateButtonStatus();
      }
    });

    prevHoriMatchBtn.addEventListener("click", () => {
      if (currentIndex - step >= 0) {
        currentIndex -= step;
      } else {
        currentIndex = 0;
      }
      scrollToCurrentItem();
      updateButtonStatus();
    });

    function scrollToCurrentItem() {
      const targetItem = items[currentIndex];
      if (targetItem) {
        const targetOffset = targetItem.offsetLeft - container.offsetLeft;
        container.scrollTo({
          left: targetOffset,
          behavior: "smooth",
        });
      }
    }
    updateButtonStatus();
  </script>



