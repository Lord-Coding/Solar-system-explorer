		<script id="soco-team-logo-fallback">
	(function (fallbacks) {
		var used = new WeakSet();
		function repair(img) {
			if (!img || img.tagName !== 'IMG' || used.has(img)) return;
			var fallback = fallbacks[img.getAttribute('src')];
			if (!fallback) return;
			used.add(img);
			img.removeAttribute('srcset');
			img.src = fallback;
		}
		document.addEventListener('error', function(e) { repair(e.target); }, true);
		document.querySelectorAll('img').forEach(function(img) {
			if (img.complete && img.naturalWidth === 0) repair(img);
		});
