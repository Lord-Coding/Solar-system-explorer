{
  "name": "solar-system-explorer",
  "version": "1.0.0",
  "description": "Interactive solar system explorer built with pure CSS",
  "scripts": {
    "build:css": "sass src/style.scss dist/style.css",
    "build": "npm run build:css",
    "build:prod": "sass src/style.scss dist/style.min.css --style=compressed",
    "watch": "sass --watch src/style.scss dist/style.css"
  },
  "devDependencies": {
    "sass": "^1.105.1"
  },
  "keywords": [
    "solar-system",
    "css",
    "scss",
    "interactive"
  ],
  "author": "Lord-Coding",
  "license": "MIT"
}
