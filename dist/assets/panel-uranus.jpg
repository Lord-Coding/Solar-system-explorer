(function(){
	var INIT=12,STEP=12;
	var api=window.socoMatchVisibilityController=window.socoMatchVisibilityController||{};
	api.enabled=true;
	var state=api.state||{visible:INIT};
	api.state=state;
	api.totalAvailable=Math.max(0,Number(api.totalAvailable)||0);
	api.getVisibleLimit=function(){return Math.max(INIT,Number(state.visible)||INIT);};
	api.setTotal=function(total){api.totalAvailable=Math.max(0,Number(total)||0);};
	function getCards(c){
		return Array.prototype.filter.call(c.children,function(el){
			return el.nodeType===1&&(el.classList.contains('match-data')||el.classList.contains('match-item'))&&!el.classList.contains('soco-stat-empty')&&!el.classList.contains('loader-container_scl');
		});
	}
	function apply(c,state){
		var cards=getCards(c),visible=Math.max(INIT,Number(state.visible)||INIT),total=Math.max(cards.length,Number(api.totalAvailable)||0);
		state.visible=visible;
		for(var i=0;i<cards.length;i++){cards[i].style.display=i<visible?'':'none';}
		var btn=document.querySelector('.load-more-wg');
		if(btn){btn.style.display=visible<total?'':'none';}
		api.visible=visible;
		api.total=total;
	}
	function bind(c,state){
		var btn=document.querySelector('.load-more-wg');
		if(!btn||btn._socoVisBound)return;
		btn._socoVisBound=1;
		btn.addEventListener('click',function(e){
			e.preventDefault();
			e.stopImmediatePropagation();
			state.visible=Math.min(Math.max(api.totalAvailable,cardsLength(c)),state.visible+STEP);
			if(typeof api.onChange==='function'){api.onChange();}else{apply(c,state);}
		},true);
	}
	function cardsLength(c){return getCards(c).length;}
	function init(){
		if(api.initialized)return;
		var c=document.getElementById('match-list-shortcode');
		if(!c)return;
		api.initialized=true;
		api.apply=function(){apply(c,state);bind(c,state);};
		api.reset=function(){state.visible=INIT;api.apply();};
		api.apply();
		var queued=false;
		new MutationObserver(function(){
			if(queued)return;
			queued=true;
			(window.requestAnimationFrame||function(cb){setTimeout(cb,16);})(function(){queued=false;api.apply();});
		}).observe(c,{childList:true});
		document.addEventListener('click',function(e){
			var target=e.target&&e.target.closest?e.target.closest('.match_filter li,.match_filter_wg li,.nav.nav-tabs .nav-link'):null;
			if(!target)return;
			state.visible=INIT;
			setTimeout(api.apply,0);
		},true);
	}
	if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
})();
(function(){var L=(window.soco_engine&&window.soco_engine.layout)||'option-8';if(!/^option-[1-8]$/.test(L))return;if(L==='option-8')return;var RE=/\boption-[1-8]\b/g;function normalise(card){if(!card||!card.getAttribute)return;var cls=card.getAttribute('class')||'';var m=cls.match(RE);if(m&&m.length===1&&m[0]===L)return;cls=cls.replace(RE,' ').replace(/\s+/g,' ').trim();cls=cls+' '+L;card.setAttribute('class',cls);}function sweep(c){var cards=c.querySelectorAll('.match-item');for(var i=0;i<cards.length;i++)normalise(cards[i]);}var queued=0;function schedule(c){if(queued)return;queued=1;(window.requestAnimationFrame||function(cb){setTimeout(cb,16);})(function(){queued=0;sweep(c);});}function init(){var c=document.getElementById('match-list-shortcode');if(!c)return;sweep(c);new MutationObserver(function(){schedule(c);}).observe(c,{childList:true,subtree:true});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}})();
(function(){
  var serverState = new Map();
  function snapshot(){
    document.querySelectorAll('.match-item[data-match-id]').forEach(function(item){
      var id = item.getAttribute('data-match-id');
      if (!id || serverState.has(id)) return;
      var b = item.getAttribute('data-bucket');
      var t = item.getAttribute('data-status-text') || '';
      var il = item.getAttribute('is-live') || '';
      var sid = item.getAttribute('status-id') || '';
      // Only snapshot rows the server tagged. Bundle-only rows
      // (e.g. cards bundle adds from live_summary AJAX later)
      // are out of scope.
      if (b) {
        serverState.set(id, { bucket: b, statusText: t, isLive: il, statusId: sid });
      }
    });
  }
  function applyServerStatus(){
    snapshot(); // pick up any newly-rendered server cards.
    document.querySelectorAll('.match-item[data-match-id]').forEach(function(item){
      var id = item.getAttribute('data-match-id');
      var saved = serverState.get(id);
      if (item.getAttribute('data-soco-state') === 'current') return;
      if (!saved) return;
      if (saved.bucket === 'live') {
        if (!item.classList.contains('live-match')) {
          item.classList.remove('finished');
          item.classList.add('live-match');
        }
        // Bundle m() flips is-live=0 when realtime array doesn't
        // contain the match. Force back to '1' so CSS keeps the
        // status-match-data badge visible (and vs-match hidden).
        if (item.getAttribute('is-live') !== '1') {
          item.setAttribute('is-live', '1');
        }
      } else if (saved.bucket === 'finished') {
        if (!item.classList.contains('finished')) {
          item.classList.remove('live-match');
          item.classList.add('finished');
        }
        // Finished cards keep is-live='1' on the server when the
        // match HAD a live broadcast — the badge text says 'Đã
        // kết thúc'. Bundle wipes is-live to 0 → CSS hides
        // status-match-data → 'VS' shown instead. Restore.
        if (saved.isLive && item.getAttribute('is-live') !== saved.isLive) {
          item.setAttribute('is-live', saved.isLive);
        }
        if (saved.statusId && item.getAttribute('status-id') !== saved.statusId) {
          item.setAttribute('status-id', saved.statusId);
        }
      }
      var st = item.querySelector('.status-text');
      // Always overwrite — bundle may have set 'VS' / '' / null. The
      // server-side bucket text is more accurate than realtime stub.
      if (st && saved.statusText && st.textContent.trim() !== saved.statusText) {
        st.textContent = saved.statusText;
      }
      // Re-paint server attrs so future intervals find them.
      if (saved.bucket && item.getAttribute('data-bucket') !== saved.bucket) {
        item.setAttribute('data-bucket', saved.bucket);
      }
      if (saved.statusText && item.getAttribute('data-status-text') !== saved.statusText) {
        item.setAttribute('data-status-text', saved.statusText);
      }
    });
  }
  // Snapshot ASAP — must run before bundle's first re-render to
  // capture the server-rendered state. DOMContentLoaded is too
  // late; bundle hooks earlier. Run inline as soon as DOM has
  // .match-item elements available, then keep applying.
  function bootstrap(){
    snapshot();
    // Tight cadence for the first ~5s — bundle's m() runs after
    // the simulated 'all' tab click (10ms post-DOMContentLoaded)
    // and again on every realtime tick. We want to overwrite each
    // re-render fast enough that humans don't perceive the flicker.
    [200, 500, 1000, 1500, 2500, 4000].forEach(function(t){ setTimeout(applyServerStatus, t); });
    setInterval(applyServerStatus, 1000);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap);
  } else {
    bootstrap();
  }
})();

      (function () {
        var INIT = 12;
        var STEP = 12;

        function getCards(container) {
            return Array.prototype.filter.call(container.children, function (el) {
                return (
                    el.nodeType === 1 &&
                    !el.classList.contains('soco-stat-empty') &&
                    !el.classList.contains('loader-container_scl')
                );
            });
        }

        function apply(container, n) {
            var cards = getCards(container);
            for (var i = 0; i < cards.length; i++) {
                cards[i].style.display = i < n ? '' : 'none';
            }
            var btn = document.querySelector('.load-more-wg');
            if (btn) {
                btn.style.display = n < cards.length ? '' : 'none';
            }
        }

        function bind(container, state) {
            var btn = document.querySelector('.load-more-wg');
            if (!btn || btn._socoVisBound) return;
            btn._socoVisBound = 1;
            btn.addEventListener(
                'click',
                function (e) {
                    e.stopImmediatePropagation();
                    state.visible += STEP;
                    apply(container, state.visible);
                },
                true
            );
        }

        function init() {
            var container = document.getElementById('match-list-shortcode');
            if (!container) return;

            var state = { visible: INIT };
            apply(container, state.visible);
            bind(container, state);

            var observer = new MutationObserver(function () {
                state.visible = INIT;
                apply(container, state.visible);
                bind(container, state);
            });
            observer.observe(container, { childList: true });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
      })();
      
