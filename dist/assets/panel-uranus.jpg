<script>
(function () {
  function setActive() {
    var items = document.querySelectorAll('.menu-bottom a[href]');
    if (!items.length) return false;

    var path = location.pathname.replace(/\/+$/, '') || '/';

    items.forEach(function (a) {
      var href = new URL(a.getAttribute('href'), location.origin)
        .pathname.replace(/\/+$/, '') || '/';

      var ok = href === '/'
        ? path === '/'
        : (path === href || path.indexOf(href + '/') === 0);

      a.classList.toggle('active', ok);
    });
    return true;
  }

  var tries = 0;
  var timer = setInterval(function () {
    tries++;
    if (setActive() || tries > 33) clearInterval(timer);
  }, 300);

  document.addEventListener('DOMContentLoaded', setActive);
  window.addEventListener('load', setActive);
})();
</script><script id="jquery-ui-core-js-before">
