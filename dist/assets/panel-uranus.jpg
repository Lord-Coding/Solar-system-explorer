nav#header .navbar-brand{display:block;height:100%;margin:0;background:unset!important;width:fit-content;padding:5px 0;overflow-y:clip;min-width:150px;}
#navbar>ul>li>a.active{color:var(--scl-head-text-hover);}
#navbar>ul>li>a.active::before{display:block;color:var(--scl-head-text-hover);background-color:var(--scl-head-menu-hover);content:"";width:calc(100%);height:calc(200% + 50px);transform:rotate(15deg);left:0;top:calc(-50% - 25px);position:absolute;z-index:-1;}
.tab-option-4 .match_filter_wg li:hover{cursor:pointer;border:1px solid #00FF66;box-shadow:1px 4px 11px 0 rgba(0,196,77,.53);}
@media (max-width:768px){.xc::before{display:none!important;}header>#header .container{background-color:var(--scl-head-menu);color:var(--scl-head-text);}.navbar-brand img{height:50px;max-height:100%;width:auto;margin:0 auto;display:block;padding:6px;background:#fff;}}
@media (max-width:518px){.xc::before{display:block!important;}.match_filter_wg{justify-content:normal!important;}}
</style>
